{
  "name": "node-modules-url-extractor",
  "displayName": "%extensionName%",
  "description": "%description%",
  "version": "0.1.1",
  "publisher": "shawn-web",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/shawn-web/node_modules-url-extractor.git"
  },
  "bugs": {
    "url": "https://github.com/shawn-web/node_modules-url-extractor/issues"
  },
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Other",
    "Extension Packs"
  ],
  "icon": "resources/icon.png",
  "activationEvents": [
    "onView:nodeModulesExtractor.tree",
    "onCommand:nodeModulesExtractor.extractUrls",
    "workspaceContains:node_modules",
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "nodeModulesExtractor",
          "title": "%extensionName%",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "nodeModulesExtractor": [
        {
          "id": "nodeModulesExtractor.tree",
          "name": "%dependencyTreeTitle%"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "nodeModulesExtractor.tree",
        "contents": "%welcomeMessage% [%extractDocument%](command:nodeModulesExtractor.extractUrls)"
      }
    ],
    "commands": [
      {
        "command": "nodeModulesExtractor.extractUrls",
        "title": "%extractUrls%",
        "icon": "$(link)"
      },
      {
        "command": "nodeModulesExtractor.configure",
        "title": "%configure%",
        "icon": "$(gear)"
      },
      {
        "command": "nodeModulesExtractor.toggleMonitoring",
        "title": "%toggleMonitoring%",
        "icon": "$(eye)"
      },
      {
        "command": "nodeModulesExtractor.refresh",
        "title": "%refresh%",
        "icon": "$(refresh)"
      },
      {
        "command": "nodeModulesExtractor.manageExclusions",
        "title": "%manageExclusions%",
        "icon": "$(exclude)"
      },
      {
        "command": "nodeModulesExtractor.changeLanguage",
        "title": "%changeLanguage%",
        "icon": "$(globe)"
      }
    ],
    "configuration": {
      "title": "%configurationTitle%",
      "properties": {
        "nodeModulesExtractor.maxDepth": {
          "type": "number",
          "default": 3,
          "minimum": 1,
          "maximum": 10,
          "description": "%maxDepth%"
        },
        "nodeModulesExtractor.outputFileName": {
          "type": "string",
          "default": "dependency-urls.md",
          "description": "%outputFileName%"
        },
        "nodeModulesExtractor.outputFormat": {
          "type": "string",
          "enum": [
            "markdown",
            "json"
          ],
          "default": "markdown",
          "description": "%outputFormat%"
        },
        "nodeModulesExtractor.autoMonitoring": {
          "type": "boolean",
          "default": true,
          "description": "%autoMonitoring%"
        },
        "nodeModulesExtractor.extractOnStartup": {
          "type": "boolean",
          "default": true,
          "description": "%extractOnStartup%"
        },
        "nodeModulesExtractor.initialDelay": {
          "type": "number",
          "default": 3000,
          "minimum": 1000,
          "maximum": 10000,
          "description": "%initialDelay%"
        },
        "nodeModulesExtractor.incrementalUpdate": {
          "type": "boolean",
          "default": true,
          "description": "%incrementalUpdate%"
        },
        "nodeModulesExtractor.excludedProjects": {
          "type": "array",
          "default": [],
          "description": "%excludedProjects%"
        },
        "nodeModulesExtractor.autoDetectProjects": {
          "type": "boolean",
          "default": true,
          "description": "%autoDetectProjects%"
        },
        "nodeModulesExtractor.includeFields": {
          "type": "array",
          "default": [
            "homepage",
            "repository",
            "bugs",
            "documentation"
          ],
          "description": "%includeFields%"
        },
        "nodeModulesExtractor.language": {
          "type": "string",
          "enum": [
            "zh-CN",
            "en"
          ],
          "default": "zh-CN",
          "description": "%language%"
        }
      }
    },
    "menus": {
      "explorer/context": [
        {
          "command": "nodeModulesExtractor.extractUrls",
          "group": "navigation",
          "when": "explorerResourceIsFolder && explorerResourceIsRoot"
        }
      ],
      "view/title": [
        {
          "command": "nodeModulesExtractor.refresh",
          "title": "%refresh%",
          "when": "view == nodeModulesExtractor.tree",
          "group": "navigation"
        },
        {
          "command": "nodeModulesExtractor.extractUrls",
          "title": "%extractUrls%",
          "when": "view == nodeModulesExtractor.tree",
          "group": "extension"
        },
        {
          "command": "nodeModulesExtractor.toggleMonitoring",
          "title": "%toggleMonitoring%",
          "when": "view == nodeModulesExtractor.tree",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "nodeModulesExtractor.extractUrls",
          "title": "%extractUrls%",
          "when": "workspaceContains:node_modules"
        },
        {
          "command": "nodeModulesExtractor.configure",
          "title": "%configure%"
        },
        {
          "command": "nodeModulesExtractor.toggleMonitoring",
          "title": "%toggleMonitoring%",
          "when": "workspaceContains:node_modules"
        },
        {
          "command": "nodeModulesExtractor.refresh",
          "title": "%refresh%",
          "when": "workspaceContains:node_modules"
        },
        {
          "command": "nodeModulesExtractor.manageExclusions",
          "title": "%manageExclusions%"
        },
        {
          "command": "nodeModulesExtractor.changeLanguage",
          "title": "%changeLanguage%"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "package": "vsce package --no-dependencies",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/glob": "^8.1.0",
    "@types/node": "16.x",
    "@types/vscode": "^1.74.0",
    "@vscode/vsce": "^3.7.1",
    "jszip": "^3.10.1",
    "typescript": "^4.9.4"
  },
  "dependencies": {
    "glob": "^10.4.5"
  }
}